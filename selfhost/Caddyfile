# MY/CO/L web server: one address for the app, its data, its login and the local model.
# Caddy listens on plain http :8080 on this computer only. HTTPS (the padlock) comes from
# Tailscale ("tailscale serve") or Cloudflare Tunnel in front of it; see docs/SELF-HOST.md.
{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	# The self-hosted app build uses the placeholder key "self-hosted" (it cannot know this box's keys).
	# Drop it so the data and login servers treat the request as "not logged in" instead of a bad key.
	@placeholder header Authorization "Bearer self-hosted"
	request_header @placeholder -Authorization
	request_header -Apikey

	# ---- the public GitHub Pages copy of the app may use this box too (CORS) ----
	# Only that one other address is allowed. The data and login servers' own CORS answers are replaced.
	@pages_preflight {
		method OPTIONS
		header Origin {$PAGES_ORIGIN}
	}
	handle @pages_preflight {
		header Access-Control-Allow-Origin "{$PAGES_ORIGIN}"
		header Access-Control-Allow-Methods "GET, POST, PATCH, PUT, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "authorization, apikey, content-type, x-client-info, x-supabase-api-version, prefer, range, accept-profile, content-profile"
		header Access-Control-Max-Age "86400"
		header Vary Origin
		respond 204
	}
	@pages header Origin {$PAGES_ORIGIN}
	header @pages >Access-Control-Allow-Origin "{$PAGES_ORIGIN}"
	header @pages >Access-Control-Expose-Headers "content-range, x-total-count"
	header @pages >Vary Origin

	# ---- tables (PostgREST) ----
	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}

	# ---- login (GoTrue) ----
	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}

	# ---- the assistant's local model ----
	# Only the chat and "which models" calls go through. Pulling or deleting models is not
	# reachable from a browser; do that on this computer with ./mycol.sh model.
	@llm_ok path /llm/api/chat /llm/api/tags /llm/api/version /llm/v1/chat/completions /llm/v1/models
	handle @llm_ok {
		uri strip_prefix /llm
		# Ollama refuses browser origins it does not know; Caddy is the gate instead.
		request_header -Origin
		request_header -Referer
		reverse_proxy {$OLLAMA_HOST_PORT} {
			header_up Host localhost
			transport http {
				read_timeout 10m
				write_timeout 10m
			}
		}
	}
	handle /llm/* {
		respond "Not here." 404
	}

	# ---- the textbook (MANUAL screen) ----
	# Never in the download. ./mycol.sh manual FILE copies it into ./manual on this computer. Only a logged-in
	# user gets it: the login server checks the request's own login token first (401 otherwise).
	handle /manual/* {
		forward_auth auth:9999 {
			uri /user
		}
		header Cache-Control "private, no-store"
		root * /srv
		file_server
	}

	# ---- the app itself ----
	handle {
		root * /srv/app
		# The service worker and page must never be cached long, or phones miss updates.
		@fresh path /sw.js /registerSW.js /index.html / /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
}
