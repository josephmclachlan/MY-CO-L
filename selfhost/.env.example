# MY/CO/L farm box settings. ./mycol.sh setup copies this to .env and fills in the secrets.
# Never share .env, never put it on GitHub. It holds the keys to all farm records.

# The address people open the app from (the Tailscale or Cloudflare https address, no slash at the end).
SITE_URL=https://farm-box.example.ts.net

# The public GitHub Pages copy of the app, allowed to use this box's model and data too.
PAGES_ORIGIN=https://josephmclachlan.github.io

# Filled in by ./mycol.sh setup. Do not change them after the first start.
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_KEY=

# 127.0.0.1 = only this computer (plus Tailscale/Cloudflare on it). 0.0.0.0 = farm wifi too, plain http.
WEB_BIND=127.0.0.1

# Assistant model (profile "ai"). Leave empty to run the app without the model.
OLLAMA_MODEL=qwen2.5:7b
# Use the Ollama installed on this computer instead of the container, e.g. host.docker.internal:11434
#OLLAMA_HOST_PORT=ollama:11434

# Govee sensors (profile "sensors"). Free key from the Govee Home app: Profile > Settings > Apply for API key.
GOVEE_API_KEY=
GOVEE_EVERY_MIN=10
GOVEE_UNIT=F

# Backups
BACKUP_DIR=./backups
# A USB drive mounted here gets a copy of every backup (leave empty if none).
USB_DIR=
# An rclone remote for the off-site copy, e.g. gdrive-crypt:mycol (leave empty if none).
OFFSITE=
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12

# Updates: a read-only GitHub token (fine-grained, this repo, Contents: read).
GITHUB_TOKEN=
GITHUB_REPO=josephmclachlan/MY-CO-L
