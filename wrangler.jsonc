// Only used if the site is deployed as a Cloudflare Worker with static assets.
// Cloudflare Pages ignores this file (it has no pages_build_output_dir).
{
  "name": "my-co-l",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
