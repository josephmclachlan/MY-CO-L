# Copy this file to .env.local for local development.
# On Cloudflare these go in the project's Settings > Variables, never in the repo.
# Both values come from Supabase > Project Settings > API Keys.
# The key is the PUBLIC one (anon or "publishable"), never the secret/service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_KEY=your-anon-or-publishable-key
